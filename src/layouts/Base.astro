---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { site, type Lang } from '../config';
import { ui, meta } from '../i18n/content';

interface Props {
  lang: Lang;
  page: string; // slug without language, '' for home, e.g. 'research'
  title?: string;
  description?: string;
}

const { lang, page, title, description } = Astro.props;
const other: Lang = lang === 'en' ? 'es' : 'en';
const href = (l: Lang, p = page) => `/${l}/${p ? p + '/' : ''}`;
const abs = (l: Lang) => new URL(href(l), site.url).href;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Evolutionary genomics`;
const desc = description ?? meta.description[lang];
const ogImage = new URL('/og.png', site.url).href;

const nav = [
  ['research', ui.nav.research],
  ['publications', ui.nav.publications],
  ['software', ui.nav.software],
  ['projects', ui.nav.projects],
  ['cv', ui.nav.cv],
  ['about', ui.nav.about],
  ['contact', ui.nav.contact],
] as const;

const sameAs = [site.links.scholar, site.links.github, site.links.linkedin];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'Visiting Scholar',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Temple University' },
  sameAs,
};
---

<!doctype html>
<html lang={lang} data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={abs(lang)} />
    <link rel="alternate" hreflang="en" href={abs('en')} />
    <link rel="alternate" hreflang="es" href={abs('es')} />
    <link rel="alternate" hreflang="x-default" href={abs('en')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Apply the stored theme before first paint to avoid a flash.
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}></script>
    <script is:inline define:vars={{ gaId: site.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip[lang]}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={href(lang, '')} aria-label={site.name}>
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="brand-name">{site.shortName}</span>
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav" data-menu>
          {ui.menu[lang]}
        </button>
        <nav id="nav" class="nav" aria-label="Main">
          {nav.map(([slug, label]) => (
            <a href={href(lang, slug)} aria-current={page === slug ? 'page' : undefined}>{label[lang]}</a>
          ))}
          <span class="nav-tools">
            <a class="lang" href={href(other)} hreflang={other} lang={other} aria-label={other === 'es' ? 'Ver en español' : 'View in English'}>
              {other.toUpperCase()}
            </a>
            <button class="theme-btn" type="button" aria-label={ui.theme[lang]} data-theme-toggle>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="4.2"></circle>
                <path d="M12 2.5v2.3M12 19.2v2.3M2.5 12h2.3M19.2 12h2.3M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
              </svg>
            </button>
          </span>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <p>© {new Date().getFullYear()} {site.name}</p>
        <p class="links">
          <a href={site.links.scholar} rel="me noopener">Scholar</a>
          <a href={site.links.github} rel="me noopener">GitHub</a>
          <a href={site.links.linkedin} rel="me noopener">LinkedIn</a>
          <a href={`mailto:${site.email}`}>{ui.email[lang]}</a>
        </p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const dark = () => matchMedia('(prefers-color-scheme: dark)').matches;
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const current = root.dataset.theme === 'auto' ? (dark() ? 'dark' : 'light') : root.dataset.theme;
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
      const btn = document.querySelector('[data-menu]');
      const nav = document.getElementById('nav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </body>
</html>
